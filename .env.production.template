# =============================================================================
# Polsia Fork — Production Environment Configuration
# =============================================================================
# Copy this file to .env and fill in all secrets.
# NEVER commit .env to version control.
# Rotate all secrets monthly.

# --- API Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=changeme-generate-32byte-secret

# --- Database ---
# Use PostgreSQL in production (SQLite only for local dev)
DATABASE_URL=postgresql+asyncpg://polsia:CHANGE_DB_PASSWORD@postgres:5432/polsia
# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Redis / Celery ---
REDIS_URL=redis://:CHANGE_REDIS_PASSWORD@redis:6379/0
CELERY_BROKER_URL=redis://:CHANGE_REDIS_PASSWORD@redis:6379/0
CELERY_RESULT_BACKEND=redis://:CHANGE_REDIS_PASSWORD@redis:6379/1

# --- LLM API (DeepSeek) ---
# Production: use real API key, NOT mock mode
LLM_API_KEY=sk-your-deepseek-api-key
LLM_API_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_MOCK=false

# --- ChromaDB ---
CHROMA_PERSIST_DIR=/data/chroma

# --- CORS ---
# Comma-separated allowed origins
CORS_ORIGINS=https://crosswave.app,https://admin.crosswave.app

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Logging ---
LOG_LEVEL=info
