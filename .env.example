# Polsia Fork (CrossWave) — Environment Configuration
# ====================================================
# Copy to .env before running: cp .env.example .env

# ─── Core ──────────────────────────────────────────────────────────────────
API_KEY=dev-key-change-in-production

# ─── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://polsia:polsia_password@localhost:5432/polsia
# DATABASE_URL=sqlite+aiosqlite:///./polsia.db  # Uncomment for local dev

# ─── Redis / Celery ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── LLM API ───────────────────────────────────────────────────────────────
LLM_API_KEY=sk-your-api-key
LLM_API_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# Mock mode: true → no real LLM calls (stub responses, for dev/testing)
LLM_API_MOCK=true

# ─── LLM Providers (Phase 3 ModelInstance) ─────────────────────────────────
MODEL_USAGE_LOG_ENABLED=false
MODEL_RATE_LIMIT_RPM=60
MODEL_RATE_LIMIT_TPM=100000

# ─── Multi-Tenancy (Phase A) ───────────────────────────────────────────────
DEFAULT_PLAN=starter
DEFAULT_AGENTS_LIMIT=3
DEFAULT_TASKS_MONTHLY_LIMIT=1000
DEFAULT_TOKENS_MONTHLY_LIMIT=10000000

# ─── Quota Enforcement (Phase A/C) ─────────────────────────────────────────
QUOTA_ENABLED=true
QUOTA_WARNING_THRESHOLD=0.8

# ─── ChromaDB / Embeddings ─────────────────────────────────────────────────
CHROMA_DB_PATH=./chroma_db
RAG_ENABLED=true
EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_BASE=https://api.openai.com/v1  # default; change if using local embeddings

# ─── Sandbox Execution (Phase C) ───────────────────────────────────────────
SANDBOX_ENABLED=false

# ─── Agent Streaming SSE (Neural Hub) ──────────────────────────────────────
AGENT_STREAMING_ENABLED=true

# ─── Durable Execution (Phase A Task 5) ────────────────────────────────────
DURABLE_EXECUTION_ENABLED=false

# ─── Config Tuner / Self-Optimization (Phase D) ────────────────────────────
CONFIG_TUNER_ENABLED=true
SELF_OPTIMIZATION_ENABLED=true

# ─── Scheduler (Phase C) ───────────────────────────────────────────────────
SCHEDULER_ENABLED=true
